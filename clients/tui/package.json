{
  "name": "@neutral/lifecycle-tui",
  "version": "1.0.0",
  "private": true,
  "description": "Journey-first Founder controller with canonical-CLI Frame preparation and print-only handoffs for Lifecycle Foundation.",
  "license": "CC0-1.0 OR 0BSD",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "bin",
    "dist/src"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "lifecycle-tui": "bin/lifecycle-tui.mjs"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "runtimeRequirements": {
    "installedLauncher": "Bun >=1.3.0",
    "exportedLibraryAndPlainPath": "Node >=24.14.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prebuild": "npm run build -w @neutral/lifecycle-protocol",
    "build": "npm run build:self",
    "build:self": "npm run clean && tsc -p tsconfig.json",
    "precheck": "npm run build -w @neutral/lifecycle-protocol",
    "check": "npm run check:self",
    "check:self": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run test:built",
    "test:built": "bun scripts/run-tests.mjs",
    "prepack": "bun scripts/stage-bundled-dependencies.mjs prepare",
    "postpack": "bun scripts/stage-bundled-dependencies.mjs cleanup"
  },
  "dependencies": {
    "@neutral/lifecycle-protocol": "1.0.0",
    "@opentui/core": "0.5.9",
    "typescript": "5.8.3",
    "web-tree-sitter": "0.25.10"
  },
  "bundledDependencies": [
    "@neutral/lifecycle-protocol",
    "@opentui/core",
    "typescript",
    "web-tree-sitter"
  ]
}
