{
  "$id": "urn:lifecycle:schema:distribution-manifest:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coordinates": {
      "additionalProperties": false,
      "properties": {
        "interfaceProtocol": { "const": "lifecycle.interface.foundation.v10" },
        "providerAdapter": { "const": "lifecycle.provider-adapter.v6" },
        "qualificationRevision": { "const": "lifecycle.foundation.1.0.0-rc.10" },
        "repositoryContract": { "const": "lifecycle.repository.v15" },
        "runtimeProtocol": { "const": "lifecycle.runtime.foundation.v10" }
      },
      "required": [
        "interfaceProtocol",
        "providerAdapter",
        "qualificationRevision",
        "repositoryContract",
        "runtimeProtocol"
      ],
      "type": "object"
    },
    "distribution": {
      "additionalProperties": false,
      "properties": {
        "nodeMinimum": { "const": "24.14.0" },
        "npmPackage": { "const": "@neutral/lifecycle" },
        "runtimeInvocationProtocol": { "const": "lifecycle.runtime-invocation.private.v1" },
        "sourceRevision": { "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$", "type": "string" },
        "version": { "const": "1.0.0" }
      },
      "required": [
        "nodeMinimum",
        "npmPackage",
        "runtimeInvocationProtocol",
        "sourceRevision",
        "version"
      ],
      "type": "object"
    },
    "images": {
      "additionalProperties": false,
      "properties": {
        "execution": { "$ref": "#/$defs/executionImage" },
        "runtime": { "$ref": "#/$defs/runtimeImage" }
      },
      "required": ["execution", "runtime"],
      "type": "object"
    },
    "schema": { "const": "lifecycle.distribution-manifest.v1" }
  },
  "required": ["coordinates", "distribution", "images", "schema"],
  "type": "object",
  "$defs": {
    "digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "executionImage": {
      "additionalProperties": false,
      "properties": {
        "agentAdapterImplementationDigest": { "$ref": "#/$defs/digest" },
        "codexVersion": { "const": "0.151.0" },
        "imageId": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$", "type": "string" },
        "indexDigest": { "$ref": "#/$defs/digest" },
        "nonRootUser": { "const": "65532:65532" },
        "platforms": {
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/executionPlatform" },
                { "properties": { "architecture": { "const": "amd64" } }, "type": "object" }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/executionPlatform" },
                { "properties": { "architecture": { "const": "arm64" } }, "type": "object" }
              ]
            }
          ],
          "type": "array"
        },
        "repository": { "const": "ghcr.io/neutral/lifecycle-execution" },
        "runnerContractDigest": { "$ref": "#/$defs/digest" },
        "runnerContractId": { "const": "lifecycle.execution-cell-runner.v1" },
        "runnerImplementationDigest": { "$ref": "#/$defs/digest" }
      },
      "required": [
        "agentAdapterImplementationDigest",
        "codexVersion",
        "imageId",
        "indexDigest",
        "nonRootUser",
        "platforms",
        "repository",
        "runnerContractDigest",
        "runnerContractId",
        "runnerImplementationDigest"
      ],
      "type": "object"
    },
    "platform": {
      "additionalProperties": false,
      "properties": {
        "architecture": { "enum": ["amd64", "arm64"] },
        "configurationDigest": { "$ref": "#/$defs/digest" },
        "os": { "const": "linux" },
        "variant": { "type": "null" }
      },
      "required": ["architecture", "configurationDigest", "os", "variant"],
      "type": "object"
    },
    "executionPlatform": {
      "additionalProperties": false,
      "properties": {
        "architecture": { "enum": ["amd64", "arm64"] },
        "codexExecutableDigest": { "$ref": "#/$defs/digest" },
        "configurationDigest": { "$ref": "#/$defs/digest" },
        "os": { "const": "linux" },
        "toolInventoryDigest": { "$ref": "#/$defs/digest" },
        "variant": { "type": "null" }
      },
      "required": [
        "architecture",
        "codexExecutableDigest",
        "configurationDigest",
        "os",
        "toolInventoryDigest",
        "variant"
      ],
      "type": "object"
    },
    "runtimeImage": {
      "additionalProperties": false,
      "properties": {
        "indexDigest": { "$ref": "#/$defs/digest" },
        "platforms": {
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/platform" },
                { "properties": { "architecture": { "const": "amd64" } }, "type": "object" }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/platform" },
                { "properties": { "architecture": { "const": "arm64" } }, "type": "object" }
              ]
            }
          ],
          "type": "array"
        },
        "repository": { "const": "ghcr.io/neutral/lifecycle-runtime" }
      },
      "required": ["indexDigest", "platforms", "repository"],
      "type": "object"
    }
  }
}
