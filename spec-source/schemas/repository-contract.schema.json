{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifecycle:schema:repository-contract:v15",
  "title": "Lifecycle Repository Contract v15",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "targetId",
    "generation",
    "canonicalBranch",
    "specification",
    "runtime",
    "provider",
    "processes",
    "atlas",
    "knowledge",
    "sourcePolicy",
    "selections",
    "productState",
    "checkBindings",
    "capabilityProfiles",
    "projectionProfiles",
    "defaults",
    "authority",
    "digest"
  ],
  "properties": {
    "$schema": {
      "const": "lifecycle.repository.v15"
    },
    "schemaVersion": {
      "const": 15
    },
    "targetId": {
      "$ref": "urn:lifecycle:schema:common:v1#/$defs/opaqueId"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "canonicalBranch": {
      "type": "string",
      "pattern": "^refs/heads/[^\\u0000-\\u001f]+$",
      "maxLength": 1024
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "publicationDigest",
        "status"
      ],
      "properties": {
        "id": {
          "const": "lifecycle"
        },
        "revision": {
          "const": "lifecycle.foundation.1.0.0-rc.10"
        },
        "publicationDigest": {
          "$ref": "urn:lifecycle:schema:common:v1#/$defs/sha256"
        },
        "status": {
          "enum": [
            "draft",
            "accepted"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatible",
        "interface"
      ],
      "properties": {
        "compatible": {
          "const": "lifecycle.runtime.foundation.v10"
        },
        "interface": {
          "const": "lifecycle.interface.foundation.v10"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultDescriptorId",
        "defaultDescriptorDigest",
        "protocol"
      ],
      "properties": {
        "defaultDescriptorId": {
          "$ref": "urn:lifecycle:schema:common:v1#/$defs/opaqueId"
        },
        "defaultDescriptorDigest": {
          "$ref": "urn:lifecycle:schema:common:v1#/$defs/sha256"
        },
        "protocol": {
          "const": "lifecycle.provider-adapter.v6"
        }
      }
    },
    "processes": {
      "type": "array",
      "prefixItems": [
        {
          "const": "delivery"
        }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "entrypoint",
        "readOnly",
        "selection"
      ],
      "properties": {
        "root": {
          "const": "atlas"
        },
        "entrypoint": {
          "const": "atlas/atlas.md"
        },
        "readOnly": { "const": true },
        "selection": { "$ref": "#/$defs/atlasSelection" }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roots",
        "owners",
        "limits"
      ],
      "properties": {
        "roots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "behavior",
            "assurance",
            "blueprint",
            "check",
            "descriptionPattern"
          ],
          "properties": {
            "behavior": {
              "const": "records/behavior"
            },
            "assurance": {
              "const": "records/assurance"
            },
            "blueprint": {
              "const": "records/blueprint"
            },
            "check": {
              "const": "records/checks"
            },
            "descriptionPattern": {
              "const": "**/_*.desc.md"
            }
          }
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:lifecycle:schema:common:v1#/$defs/ownerId"
          }
        },
        "limits": {
          "$ref": "#/$defs/knowledgeLimits"
        }
      }
    },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "externalLocal",
        "network"
      ],
      "properties": {
        "repository": {
          "const": "exact-bound-tree"
        },
        "externalLocal": {
          "const": "denied"
        },
        "network": {
          "const": "denied"
        }
      }
    },
    "selections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemas",
        "profiles",
        "controlStore",
        "controlLifecycleProfile",
        "controlRecordRevision",
        "controlRecordEvent",
        "controlReferencedFile",
        "controlStoreSeal",
        "controlStoreArchive",
        "deliveryReduction",
        "candidateRevisionCarrierManifest",
        "executionBackendProfile",
        "executionCellRunner",
        "executionSpecification",
        "executionInputSet",
        "executionImage",
        "executionObservation",
        "executionOutputManifest",
        "extensions"
      ],
      "properties": {
        "schemas": {
          "const": [
            "urn:lifecycle:schema:agent-attempt-payload:v3",
            "urn:lifecycle:schema:agent-work-product-payload:v2",
            "urn:lifecycle:schema:atlas-resolution:v2",
            "urn:lifecycle:schema:atlas-state:v1",
            "urn:lifecycle:schema:candidate-revision-carrier-manifest:v1",
            "urn:lifecycle:schema:candidate-revision-payload:v2",
            "urn:lifecycle:schema:candidate-seal-payload:v2",
            "urn:lifecycle:schema:capability-profile:v2",
            "urn:lifecycle:schema:check-receipt-payload:v2",
            "urn:lifecycle:schema:closure-payload:v4",
            "urn:lifecycle:schema:common:v1",
            "urn:lifecycle:schema:conformance-claim:v2",
            "urn:lifecycle:schema:control-lifecycle-profile:v4",
            "urn:lifecycle:schema:control-record-event:v2",
            "urn:lifecycle:schema:control-record-file:v1",
            "urn:lifecycle:schema:control-record-revision:v1",
            "urn:lifecycle:schema:control-record-store-archive:v1",
            "urn:lifecycle:schema:control-record-store-seal:v1",
            "urn:lifecycle:schema:control-record-store:v1",
            "urn:lifecycle:schema:delivery-reduction:v2",
            "urn:lifecycle:schema:evidence-packet-payload:v1",
            "urn:lifecycle:schema:execution-backend-profile:v1",
            "urn:lifecycle:schema:execution-image:v1",
            "urn:lifecycle:schema:execution-input-set:v1",
            "urn:lifecycle:schema:execution-observation:v1",
            "urn:lifecycle:schema:execution-output-manifest:v1",
            "urn:lifecycle:schema:execution-receipt-payload:v3",
            "urn:lifecycle:schema:execution-specification:v1",
            "urn:lifecycle:schema:fixture-manifest:v1",
            "urn:lifecycle:schema:founder-brief-payload:v1",
            "urn:lifecycle:schema:founder-decision-payload:v4",
            "urn:lifecycle:schema:investment-allocation:v1",
            "urn:lifecycle:schema:knowledge-projection:v4",
            "urn:lifecycle:schema:knowledge-record:v1",
            "urn:lifecycle:schema:material-condition-payload:v1",
            "urn:lifecycle:schema:product-state:v1",
            "urn:lifecycle:schema:projection-request:v4",
            "urn:lifecycle:schema:provider-descriptor:v6",
            "urn:lifecycle:schema:publication-manifest:v1",
            "urn:lifecycle:schema:publication-statement:v1",
            "urn:lifecycle:schema:release-notes:v1",
            "urn:lifecycle:schema:repository-contract:v15",
            "urn:lifecycle:schema:repository-snapshot:v1",
            "urn:lifecycle:schema:validation-result:v1",
            "urn:lifecycle:schema:work-boundary-payload:v4"
          ]
        },
        "profiles": {
          "const": [
            "knowledge-set-v1",
            "knowledge-structural-v1",
            "repository-v7"
          ]
        },
        "controlStore": {
          "const": "lifecycle.control-record-store.v1"
        },
        "controlLifecycleProfile": {
          "const": "foundation-delivery-control-lifecycle-v4"
        },
        "controlRecordRevision": {
          "const": "lifecycle.control-record-revision.v1"
        },
        "controlRecordEvent": {
          "const": "lifecycle.control-record-event.v2"
        },
        "controlReferencedFile": {
          "const": "lifecycle.control-record-file.v1"
        },
        "controlStoreSeal": {
          "const": "lifecycle.control-record-store-seal.v1"
        },
        "controlStoreArchive": {
          "const": "lifecycle.control-record-store-archive.v1"
        },
        "deliveryReduction": {
          "const": "lifecycle.delivery-reduction.v2"
        },
        "candidateRevisionCarrierManifest": {
          "const": "lifecycle.candidate-revision-carrier-manifest.v1"
        },
        "executionBackendProfile": {
          "const": "lifecycle.execution-backend-profile.docker-local.v1"
        },
        "executionCellRunner": {
          "const": "lifecycle.execution-cell-runner.v1"
        },
        "executionSpecification": {
          "const": "lifecycle.execution-specification.v1"
        },
        "executionInputSet": {
          "const": "lifecycle.execution-input-set.v1"
        },
        "executionImage": {
          "const": "lifecycle.execution-image.v1"
        },
        "executionObservation": {
          "const": "lifecycle.execution-observation.v1"
        },
        "executionOutputManifest": {
          "const": "lifecycle.execution-output-manifest.v1"
        },
        "extensions": {
          "const": []
        }
      }
    },
    "productState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roots",
        "exclusions",
        "governedImplementationRoots",
        "coverageExemptions"
      ],
      "properties": {
        "roots": {
          "$ref": "#/$defs/pathSet",
          "not": {
            "contains": {
              "type": "string",
              "pattern": "^records/control(?:/|$)"
            }
          }
        },
        "exclusions": {
          "$ref": "#/$defs/pathSet",
          "not": {
            "contains": {
              "type": "string",
              "pattern": "^records/control(?:/|$)"
            }
          }
        },
        "governedImplementationRoots": {
          "$ref": "#/$defs/pathSet"
        },
        "coverageExemptions": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "$ref": "urn:lifecycle:schema:common:v1#/$defs/normalizedPath"
              },
              "reason": {
                "$ref": "urn:lifecycle:schema:common:v1#/$defs/plainText"
              }
            }
          }
        }
      }
    },
    "checkBindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/checkBinding"
      }
    },
    "capabilityProfiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/capabilityProfile"
      }
    },
    "projectionProfiles": {
      "type": "object",
      "minProperties": 3,
      "required": [
        "execution-large-v1",
        "execution-standard-v1",
        "orientation-standard-v1"
      ],
      "properties": {
        "execution-large-v1": {
          "allOf": [
            {
              "$ref": "#/$defs/projectionProfile"
            },
            {
              "properties": {
                "id": {
                  "const": "execution-large-v1"
                },
                "maximumMandatoryItems": {
                  "const": 4096
                },
                "maximumMandatoryBytes": {
                  "const": 67108864
                },
                "maximumItemBytes": {
                  "const": 4194304
                },
                "maximumReachableItems": {
                  "const": 16384
                },
                "maximumReachableBytes": {
                  "const": 134217728
                },
                "maximumSourceBytes": {
                  "const": 33554432
                },
                "maximumRelationshipDepth": {
                  "const": 128
                }
              }
            }
          ]
        },
        "execution-standard-v1": {
          "allOf": [
            {
              "$ref": "#/$defs/projectionProfile"
            },
            {
              "properties": {
                "id": {
                  "const": "execution-standard-v1"
                },
                "maximumMandatoryItems": {
                  "const": 512
                },
                "maximumMandatoryBytes": {
                  "const": 8388608
                },
                "maximumItemBytes": {
                  "const": 1048576
                },
                "maximumReachableItems": {
                  "const": 4096
                },
                "maximumReachableBytes": {
                  "const": 33554432
                },
                "maximumSourceBytes": {
                  "const": 8388608
                },
                "maximumRelationshipDepth": {
                  "const": 32
                }
              }
            }
          ]
        },
        "orientation-standard-v1": {
          "allOf": [
            {
              "$ref": "#/$defs/projectionProfile"
            },
            {
              "properties": {
                "id": {
                  "const": "orientation-standard-v1"
                },
                "maximumMandatoryItems": {
                  "const": 256
                },
                "maximumMandatoryBytes": {
                  "const": 4194304
                },
                "maximumItemBytes": {
                  "const": 1048576
                },
                "maximumReachableItems": {
                  "const": 4096
                },
                "maximumReachableBytes": {
                  "const": 33554432
                },
                "maximumSourceBytes": {
                  "const": 8388608
                },
                "maximumRelationshipDepth": {
                  "const": 24
                }
              }
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/projectionProfile"
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityProfileId",
        "orientationProjectionProfileId",
        "executionProjectionProfileId",
        "providerDescriptorId"
      ],
      "properties": {
        "capabilityProfileId": {
          "$ref": "urn:lifecycle:schema:common:v1#/$defs/opaqueId"
        },
        "orientationProjectionProfileId": {
          "$ref": "urn:lifecycle:schema:common:v1#/$defs/opaqueId"
        },
        "executionProjectionProfileId": {
          "$ref": "urn:lifecycle:schema:common:v1#/$defs/opaqueId"
        },
        "providerDescriptorId": {
          "$ref": "urn:lifecycle:schema:common:v1#/$defs/opaqueId"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principalId",
        "keyId",
        "publicKey"
      ],
      "properties": {
        "principalId": {
          "$ref": "urn:lifecycle:schema:common:v1#/$defs/ownerId"
        },
        "keyId": {
          "$ref": "urn:lifecycle:schema:common:v1#/$defs/opaqueId"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^ed25519:[A-Za-z0-9+/=]+$",
          "maxLength": 4096
        }
      }
    },
    "digest": {
      "$ref": "urn:lifecycle:schema:common:v1#/$defs/sha256"
    }
  },
  "$defs": {
    "atlasSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "specificationRevision",
        "authoredFormat",
        "processorRevision",
        "validationProfile",
        "validationResultSchema",
        "normalizedModelSchema",
        "consumerProfile"
      ],
      "properties": {
        "release": { "const": "0.7.0" },
        "specificationRevision": { "const": "429fee62966f4d30e91ec2a15d27ecf353f5d68f" },
        "authoredFormat": { "const": 1 },
        "processorRevision": { "const": "746cbce73c51b28d617b96ca08f18d498ac749c4" },
        "validationProfile": { "const": "neutral.atlas-validator.resolved" },
        "validationResultSchema": { "const": "urn:atlas:schema:validation-result:1" },
        "normalizedModelSchema": { "const": "urn:atlas:schema:normalized:1" },
        "consumerProfile": { "const": "lifecycle.atlas-consumer.v1" }
      }
    },
    "pathSet": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:lifecycle:schema:common:v1#/$defs/normalizedPath"
      }
    },
    "knowledgeLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumRecords",
        "maximumTotalRecordBytes",
        "maximumFileBytes",
        "maximumFrontMatterBytes",
        "maximumJsonDepth",
        "maximumJsonNodes",
        "maximumObjectProperties",
        "maximumArrayItems",
        "maximumBodyLines",
        "maximumHeadings",
        "maximumHeadingBytes",
        "maximumPathBytes",
        "maximumGraphNodes",
        "maximumGraphEdges",
        "maximumNodeDegree",
        "maximumSources",
        "maximumSourcesPerRecord",
        "maximumSourceBytes",
        "maximumTotalSourceBytes"
      ],
      "properties": {
        "maximumRecords": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "maximumTotalRecordBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "maximumFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "maximumFrontMatterBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 524288
        },
        "maximumJsonDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maximumJsonNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "maximumObjectProperties": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maximumArrayItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maximumBodyLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        },
        "maximumHeadings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maximumHeadingBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "maximumPathBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maximumGraphNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "maximumGraphEdges": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "maximumNodeDegree": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maximumSources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "maximumSourcesPerRecord": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "maximumSourceBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "maximumTotalSourceBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        }
      }
    },
    "capabilityProfile": {
      "$ref": "urn:lifecycle:schema:capability-profile:v2"
    },
    "projectionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "maximumMandatoryItems",
        "maximumMandatoryBytes",
        "maximumItemBytes",
        "maximumReachableItems",
        "maximumReachableBytes",
        "maximumSourceBytes",
        "maximumRelationshipDepth",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "urn:lifecycle:schema:common:v1#/$defs/opaqueId"
        },
        "maximumMandatoryItems": {
          "type": "integer",
          "minimum": 1
        },
        "maximumMandatoryBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "maximumItemBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maximumReachableItems": {
          "type": "integer",
          "minimum": 0
        },
        "maximumReachableBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumSourceBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maximumRelationshipDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "digest": {
          "$ref": "urn:lifecycle:schema:common:v1#/$defs/sha256"
        }
      }
    },
    "checkBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "checkIds",
        "subjectSelectors",
        "kind",
        "executable",
        "args",
        "cwd",
        "network",
        "timeoutMs",
        "allowedModalities",
        "capabilityProfileId",
        "environment",
        "resultParser",
        "mutation",
        "implementationDigest",
        "limitations",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "urn:lifecycle:schema:common:v1#/$defs/opaqueId"
        },
        "checkIds": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:lifecycle:schema:common:v1#/$defs/knowledgeId"
          }
        },
        "subjectSelectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/checkSubjectSelector"
          }
        },
        "kind": {
          "const": "command"
        },
        "executable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relativeTo", "path"],
          "properties": {
            "relativeTo": { "enum": ["candidate", "execution-image"] },
            "path": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/normalizedPath" }
          }
        },
        "args": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "cwd": {
          "oneOf": [
            {
              "const": "."
            },
            {
              "$ref": "urn:lifecycle:schema:common:v1#/$defs/normalizedPath"
            }
          ]
        },
        "network": {
          "enum": [
            "none",
            "loopback"
          ]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "allowedModalities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "precondition",
              "repair-target",
              "regression-guard",
              "postcondition",
              "diagnostic"
            ]
          }
        },
        "capabilityProfileId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:lifecycle:schema:common:v1#/$defs/opaqueId"
            }
          ]
        },
        "environment": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "allOf": [
              {
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              },
              {
                "not": {
                  "pattern": "^(?:PATH|HOME|TMPDIR|LANG|LC_ALL|TZ)$"
                }
              }
            ]
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
