{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifecycle:schema:evidence-packet-payload:v1",
  "title": "Lifecycle Evidence Packet Payload v1",
  "description": "Bounded normalized evaluation ledgers and derived readiness for one exact sealed Candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profileId",
    "ruleSet",
    "evaluatedAt",
    "artifacts",
    "descriptionCoverage",
    "receiptUse",
    "invalidations",
    "reviewerIndependence",
    "propositionDecisions",
    "obligations",
    "diagnostics",
    "uncertainty",
    "validator",
    "readiness"
  ],
  "properties": {
    "schema": { "const": "lifecycle.evidence-packet-payload.v1" },
    "profileId": { "const": "lifecycle.evidence-packet.foundation-v1" },
    "ruleSet": { "$ref": "#/$defs/implementation" },
    "evaluatedAt": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/canonicalTime" },
    "artifacts": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactEntry" }
    },
    "descriptionCoverage": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/descriptionEntry" }
    },
    "receiptUse": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/receiptUseEntry" }
    },
    "invalidations": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/invalidationEntry" }
    },
    "reviewerIndependence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/independenceEntry" }
    },
    "propositionDecisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/propositionEntry" }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/obligationEntry" }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "itemIds"],
      "properties": {
        "level": { "enum": ["none", "bounded", "material", "unknown"] },
        "itemIds": { "$ref": "#/$defs/idSet" }
      }
    },
    "validator": { "$ref": "#/$defs/implementation" },
    "readiness": { "enum": ["acceptance-ready", "correctable", "revision-required", "no-ship-recommended"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "readiness": { "const": "acceptance-ready" } },
        "required": ["readiness"]
      },
      "then": {
        "properties": {
          "artifacts": {
            "items": { "properties": { "state": { "const": "satisfied" } } }
          },
          "descriptionCoverage": {
            "items": { "properties": { "state": { "enum": ["satisfied", "not-applicable"] } } }
          },
          "receiptUse": {
            "items": {
              "allOf": [
                { "properties": { "use": { "enum": ["executed", "reused", "excluded"] } } },
                {
                  "if": {
                    "properties": { "use": { "enum": ["executed", "reused"] } },
                    "required": ["use"]
                  },
                  "then": {
                    "properties": {
                      "receiptId": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
                      "freshness": { "const": "fresh" },
                      "subjectEquivalence": { "enum": ["exact", "proven-equivalent"] }
                    }
                  },
                  "else": {
                    "properties": {
                      "receiptId": { "type": "null" },
                      "freshness": { "const": "not-applicable" }
                    }
                  }
                }
              ]
            }
          },
          "invalidations": {
            "items": { "properties": { "state": { "const": "current" } } }
          },
          "reviewerIndependence": {
            "items": {
              "properties": {
                "providerSession": { "const": "fresh" },
                "subjectDisposition": { "const": "exact-read-only" },
                "state": { "const": "satisfied" }
              }
            }
          },
          "propositionDecisions": {
            "items": {
              "properties": {
                "reviewerDisposition": { "enum": ["accepted", "not-applicable"] },
                "uncertainty": { "enum": ["none", "bounded"] },
                "validation": { "const": "valid" }
              }
            }
          },
          "obligations": {
            "items": { "properties": { "state": { "enum": ["satisfied", "not-applicable"] } } }
          },
          "diagnostics": { "maxItems": 0 },
          "uncertainty": {
            "properties": { "level": { "enum": ["none", "bounded"] } }
          }
        }
      }
    }
  ],
  "$defs": {
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "digest": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/sha256" }
      }
    },
    "idSet": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" }
    },
    "nullableDigest": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "urn:lifecycle:schema:common:v1#/$defs/sha256" }
      ]
    },
    "nullableId": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" }
      ]
    },
    "nullableAge": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      ]
    },
    "artifactEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifactId",
        "path",
        "fileKind",
        "existence",
        "change",
        "contentDigest",
        "manifestDigest",
        "schemaValidation",
        "semanticValidation",
        "obligationIds",
        "sourceRecordIds",
        "limitations",
        "state",
        "provenance"
      ],
      "properties": {
        "id": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "artifactId": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "path": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/normalizedPath" },
        "fileKind": { "enum": ["file", "directory", "symlink", "submodule", "absent"] },
        "existence": { "enum": ["present", "absent"] },
        "change": { "enum": ["added", "modified", "deleted", "unchanged", "not-applicable", "indeterminate"] },
        "contentDigest": { "$ref": "#/$defs/nullableDigest" },
        "manifestDigest": { "$ref": "#/$defs/nullableDigest" },
        "schemaValidation": { "enum": ["valid", "invalid", "not-required", "indeterminate"] },
        "semanticValidation": { "enum": ["valid", "invalid", "not-required", "indeterminate"] },
        "obligationIds": { "$ref": "#/$defs/idSet" },
        "sourceRecordIds": { "$ref": "#/$defs/idSet" },
        "limitations": { "$ref": "#/$defs/idSet" },
        "state": { "enum": ["satisfied", "failed", "indeterminate", "not-applicable"] },
        "provenance": { "const": "runtime-observed" }
      }
    },
    "descriptionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "descriptionId",
        "selector",
        "ownership",
        "implementationChange",
        "descriptionChange",
        "exclusionChange",
        "obligationIds",
        "sourceRecordIds",
        "state",
        "provenance"
      ],
      "properties": {
        "id": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "path": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/normalizedPath" },
        "descriptionId": { "$ref": "#/$defs/nullableId" },
        "selector": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "urn:lifecycle:schema:common:v1#/$defs/singleLine" }
          ]
        },
        "ownership": { "enum": ["exact", "missing", "ambiguous", "excluded", "indeterminate"] },
        "implementationChange": { "enum": ["changed", "unchanged", "absent"] },
        "descriptionChange": { "enum": ["changed", "unchanged", "absent"] },
        "exclusionChange": { "enum": ["none", "new", "widened", "narrowed"] },
        "obligationIds": { "$ref": "#/$defs/idSet" },
        "sourceRecordIds": { "$ref": "#/$defs/idSet" },
        "state": { "enum": ["satisfied", "failed", "indeterminate", "not-applicable"] },
        "provenance": { "const": "runtime-observed" }
      }
    },
    "receiptUseEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "checkId",
        "phase",
        "receiptId",
        "use",
        "freshness",
        "subjectEquivalence",
        "ageMs",
        "maximumAgeMs",
        "reasonCode",
        "provenance"
      ],
      "properties": {
        "id": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "checkId": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "phase": { "enum": ["baseline", "final"] },
        "receiptId": { "$ref": "#/$defs/nullableId" },
        "use": { "enum": ["executed", "reused", "excluded", "missing"] },
        "freshness": { "enum": ["fresh", "stale", "not-applicable", "indeterminate"] },
        "subjectEquivalence": { "enum": ["exact", "proven-equivalent", "not-equivalent", "indeterminate"] },
        "ageMs": { "$ref": "#/$defs/nullableAge" },
        "maximumAgeMs": { "$ref": "#/$defs/nullableAge" },
        "reasonCode": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlRecordKind" },
        "provenance": { "const": "runtime-derived" }
      }
    },
    "invalidationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subjectRecordId", "dependencyClass", "currentInputId", "causeIds", "state", "reasonCode", "provenance"],
      "properties": {
        "id": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "subjectRecordId": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "dependencyClass": { "enum": ["candidate", "boundary", "check-definition", "binding", "knowledge", "environment", "reviewer-subject"] },
        "currentInputId": { "$ref": "#/$defs/nullableId" },
        "causeIds": { "$ref": "#/$defs/idSet" },
        "state": { "enum": ["current", "invalidated"] },
        "reasonCode": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlRecordKind" },
        "provenance": { "const": "runtime-derived" }
      }
    },
    "independenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ruleId",
        "attemptId",
        "workProductId",
        "receiptId",
        "capabilityDigest",
        "projectionDigest",
        "providerSession",
        "subjectDisposition",
        "state",
        "provenance"
      ],
      "properties": {
        "id": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "ruleId": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "attemptId": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "workProductId": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "receiptId": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "capabilityDigest": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/sha256" },
        "projectionDigest": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/sha256" },
        "providerSession": { "enum": ["fresh", "reused", "indeterminate"] },
        "subjectDisposition": { "enum": ["exact-read-only", "mutated", "indeterminate"] },
        "state": { "enum": ["satisfied", "failed", "indeterminate"] },
        "provenance": { "const": "runtime-derived" }
      }
    },
    "propositionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "propositionId",
        "reviewerDisposition",
        "reviewWorkProductId",
        "fragmentDigest",
        "citationIds",
        "inspectedSubjectIds",
        "limitationIds",
        "uncertainty",
        "provenance",
        "validation"
      ],
      "properties": {
        "id": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "propositionId": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "reviewerDisposition": { "enum": ["accepted", "rejected", "indeterminate", "not-applicable"] },
        "reviewWorkProductId": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "fragmentDigest": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/sha256" },
        "citationIds": { "$ref": "#/$defs/idSet" },
        "inspectedSubjectIds": { "$ref": "#/$defs/idSet" },
        "limitationIds": { "$ref": "#/$defs/idSet" },
        "uncertainty": { "enum": ["none", "bounded", "material", "unknown"] },
        "provenance": { "const": "agent-proposed" },
        "validation": { "enum": ["valid", "invalid", "indeterminate"] }
      }
    },
    "obligationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "obligationId",
        "state",
        "checkIds",
        "receiptIds",
        "propositionDecisionIds",
        "artifactLedgerIds",
        "reasonCode",
        "provenance"
      ],
      "properties": {
        "id": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "obligationId": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "state": { "enum": ["satisfied", "failed", "indeterminate", "missing", "not-applicable", "stale", "unsupported"] },
        "checkIds": { "$ref": "#/$defs/idSet" },
        "receiptIds": { "$ref": "#/$defs/idSet" },
        "propositionDecisionIds": { "$ref": "#/$defs/idSet" },
        "artifactLedgerIds": { "$ref": "#/$defs/idSet" },
        "reasonCode": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlRecordKind" },
        "provenance": { "const": "runtime-derived" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "factsDigest"],
      "properties": {
        "code": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlId" },
        "stage": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/controlRecordKind" },
        "factsDigest": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/sha256" }
      }
    }
  }
}
