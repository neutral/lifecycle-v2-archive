{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifecycle:schema:fixture-manifest:v1",
  "title": "Lifecycle Fixture Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "specificationId", "specificationRevision", "fixtures"],
  "properties": {
    "schema": { "const": "lifecycle.fixture-manifest.v1" },
    "specificationId": { "const": "lifecycle" },
    "specificationRevision": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/opaqueId" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "diagnosticList": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^lifecycle\\.[A-Za-z0-9._-]+$"
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "profile", "complete", "valid", "diagnostics", "allowedDiagnostics", "subjectDigest", "description"],
      "properties": {
        "id": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/opaqueId" },
        "path": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/normalizedPath" },
        "profile": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/opaqueId" },
        "complete": { "type": "boolean" },
        "valid": { "type": "boolean" },
        "diagnostics": { "$ref": "#/$defs/diagnosticList" },
        "allowedDiagnostics": { "$ref": "#/$defs/diagnosticList" },
        "subjectDigest": {
          "oneOf": [
            { "$ref": "urn:lifecycle:schema:common:v1#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "description": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/plainText" }
      },
      "allOf": [
        {
          "if": { "properties": { "valid": { "const": true } } },
          "then": {
            "properties": {
              "complete": { "const": true },
              "diagnostics": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "diagnostics": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
