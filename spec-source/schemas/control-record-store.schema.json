{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifecycle:schema:control-record-store:v2",
  "title": "Lifecycle Control Record Store Identity v2",
  "description": "Immutable identity of one runtime-owned Delivery Control Record Store.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "storeId", "targetId", "processKind", "processId", "createdAt"],
  "properties": {
    "schema": { "const": "lifecycle.control-record-store.v2" },
    "storeId": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/controlId" },
    "targetId": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/controlId" },
    "processKind": { "const": "delivery" },
    "processId": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/controlId" },
    "createdAt": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/canonicalTime" }
  }
}
