{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifecycle:schema:atlas-state:v1",
  "title": "Lifecycle Atlas State v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries", "digest"],
  "properties": {
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/entry" }
    },
    "digest": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/sha256" }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "objectId"],
      "properties": {
        "path": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/normalizedPath" },
        "mode": { "const": "100644" },
        "objectId": { "$ref": "urn:lifecycle:schema:common:v1#/$defs/gitObject" }
      }
    }
  }
}
