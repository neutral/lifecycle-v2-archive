{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifecycle:schema:execution-backend-profile:v1",
  "title": "Lifecycle Execution Backend Profile v1",
  "description": "Exact installed contract for one Runtime-private Execution Backend configuration.",
  "$comment": "Semantic validation recomputes digest over the complete value without digest, orders platforms and qualificationClaims canonically, proves every claimed platform and guarantee against the installed implementation and operated evidence, and requires every effective Execution Specification to be a restriction of this profile. This value never contains an endpoint, daemon or container identifier, Execution Handle, allocation key, credential value, private path, or mutable backend state. The fault-injection profile is test-only and cannot establish Docker isolation or serve as a production fallback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profileId",
    "backendKind",
    "usage",
    "implementation",
    "engineContract",
    "platforms",
    "isolation",
    "lifecycleGuarantees",
    "imagePolicy",
    "transferPolicy",
    "networkPolicy",
    "credentialPolicy",
    "limits",
    "outputPolicy",
    "qualificationClaims",
    "digest"
  ],
  "properties": {
    "schema": { "const": "lifecycle.execution-backend-profile.v1" },
    "profileId": {
      "enum": [
        "lifecycle.execution-backend-profile.docker-local.v1",
        "lifecycle.execution-backend-profile.fault-injection.v1"
      ]
    },
    "backendKind": { "enum": ["docker-local", "fault-injection"] },
    "usage": { "enum": ["production", "test-only"] },
    "implementation": { "$ref": "#/$defs/implementation" },
    "engineContract": { "$ref": "#/$defs/engineContract" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/platform" }
    },
    "isolation": { "$ref": "#/$defs/isolation" },
    "lifecycleGuarantees": { "$ref": "#/$defs/lifecycleGuarantees" },
    "imagePolicy": { "$ref": "#/$defs/imagePolicy" },
    "transferPolicy": { "$ref": "#/$defs/transferPolicy" },
    "networkPolicy": { "$ref": "#/$defs/networkPolicy" },
    "credentialPolicy": { "$ref": "#/$defs/credentialPolicy" },
    "limits": { "$ref": "#/$defs/limits" },
    "outputPolicy": { "$ref": "#/$defs/outputPolicy" },
    "qualificationClaims": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/qualificationClaim" }
    },
    "digest": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profileId": { "const": "lifecycle.execution-backend-profile.docker-local.v1" }
        },
        "required": ["profileId"]
      },
      "then": {
        "properties": {
          "backendKind": { "const": "docker-local" },
          "usage": { "const": "production" },
          "engineContract": {
            "type": "object",
            "properties": { "kind": { "const": "docker-engine" } },
            "required": ["kind"]
          },
          "isolation": {
            "type": "object",
            "properties": { "mechanism": { "const": "oci-container" } },
            "required": ["mechanism"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profileId": { "const": "lifecycle.execution-backend-profile.fault-injection.v1" }
        },
        "required": ["profileId"]
      },
      "then": {
        "properties": {
          "backendKind": { "const": "fault-injection" },
          "usage": { "const": "test-only" },
          "engineContract": {
            "type": "object",
            "properties": { "kind": { "const": "deterministic-test-engine" } },
            "required": ["kind"]
          },
          "isolation": {
            "type": "object",
            "properties": { "mechanism": { "const": "deterministic-test-cell" } },
            "required": ["mechanism"]
          }
        }
      }
    }
  ],
  "$defs": {
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "implementationDigest", "contractDigest"],
      "properties": {
        "id": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/controlId" },
        "version": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/singleLine" },
        "implementationDigest": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/sha256" },
        "contractDigest": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/sha256" }
      }
    },
    "engineContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "compatibilityProfileId", "compatibleVersion", "contractDigest"],
      "properties": {
        "kind": { "enum": ["docker-engine", "deterministic-test-engine"] },
        "compatibilityProfileId": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/controlId" },
        "compatibleVersion": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/singleLine" },
        "contractDigest": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/sha256" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "variant"],
      "properties": {
        "os": { "const": "linux" },
        "architecture": { "enum": ["amd64", "arm64"] },
        "variant": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "urn:lifecycle:schema:common:v2#/$defs/controlId" }
          ]
        }
      }
    },
    "isolation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mechanism",
            "nonRootRunner",
            "privileged",
            "hostPidNamespace",
            "hostNetworkNamespace",
            "dockerSocket",
            "canonicalRepositoryMount",
            "runtimeCustodyMount",
            "completeProcessBoundary",
            "productionIsolationClaim"
          ],
          "properties": {
            "mechanism": { "const": "oci-container" },
            "nonRootRunner": { "const": true },
            "privileged": { "const": false },
            "hostPidNamespace": { "const": false },
            "hostNetworkNamespace": { "const": false },
            "dockerSocket": { "const": false },
            "canonicalRepositoryMount": { "const": false },
            "runtimeCustodyMount": { "const": false },
            "completeProcessBoundary": { "const": true },
            "productionIsolationClaim": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanism", "modelsFailureSemantics", "productionIsolationClaim"],
          "properties": {
            "mechanism": { "const": "deterministic-test-cell" },
            "modelsFailureSemantics": { "const": true },
            "productionIsolationClaim": { "const": false }
          }
        }
      ]
    },
    "lifecycleGuarantees": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministicAllocation",
        "oneCellPerSpecification",
        "oneTimeDispatch",
        "directObservation",
        "monotonicCancellation",
        "retrievalAfterContainment",
        "retirementBeforeCompletion",
        "reclamationAfterRetirement"
      ],
      "properties": {
        "deterministicAllocation": { "const": true },
        "oneCellPerSpecification": { "const": true },
        "oneTimeDispatch": { "const": true },
        "directObservation": { "const": true },
        "monotonicCancellation": { "const": true },
        "retrievalAfterContainment": { "const": true },
        "retirementBeforeCompletion": { "const": true },
        "reclamationAfterRetirement": { "const": true }
      }
    },
    "imagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immutableDigestRequired", "mutableTagsAllowed", "platformVerification", "runnerAndToolInventoryVerification"],
      "properties": {
        "immutableDigestRequired": { "const": true },
        "mutableTagsAllowed": { "const": false },
        "platformVerification": { "const": true },
        "runnerAndToolInventoryVerification": { "const": true }
      }
    },
    "transferPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputModes", "outputModes", "contentValidation", "physicalIdentityIsLogicalInput"],
      "properties": {
        "inputModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["bounded-archive", "bounded-volume"] }
        },
        "outputModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["bounded-archive", "bounded-volume"] }
        },
        "contentValidation": { "const": "runtime-independent" },
        "physicalIdentityIsLogicalInput": { "const": false }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerControlPlaneModes", "agentProductNetworkModes", "separationRequired"],
      "properties": {
        "providerControlPlaneModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["none", "fixed-service-channel"] }
        },
        "agentProductNetworkModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["none", "loopback", "bounded-egress"] }
        },
        "separationRequired": { "const": true }
      }
    },
    "credentialPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["injectionModes", "agentAccess", "outputDisclosure", "diagnosticDisclosure"],
      "properties": {
        "injectionModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["none", "fixed-runner", "isolated-broker"] }
        },
        "agentAccess": { "const": false },
        "outputDisclosure": { "const": false },
        "diagnosticDisclosure": { "const": false }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumWallTimeMilliseconds",
        "maximumProcesses",
        "maximumStorageBytes",
        "maximumOutputEntries",
        "maximumOutputBytes",
        "maximumOutputEntryBytes",
        "maximumEvents"
      ],
      "properties": {
        "maximumWallTimeMilliseconds": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/positiveSafeInteger" },
        "maximumProcesses": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/positiveSafeInteger" },
        "maximumStorageBytes": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/positiveSafeInteger" },
        "maximumOutputEntries": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/positiveSafeInteger" },
        "maximumOutputBytes": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/positiveSafeInteger" },
        "maximumOutputEntryBytes": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/positiveSafeInteger" },
        "maximumEvents": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/positiveSafeInteger" }
      }
    },
    "outputPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestProfile", "allowedModeClasses", "linksAllowed", "specialFilesAllowed", "extraEntriesAllowed"],
      "properties": {
        "manifestProfile": { "const": "lifecycle.execution-output-manifest.v1" },
        "allowedModeClasses": { "const": ["regular", "executable"] },
        "linksAllowed": { "const": false },
        "specialFilesAllowed": { "const": false },
        "extraEntriesAllowed": { "const": false }
      }
    },
    "qualificationClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "evidenceDigest"],
      "properties": {
        "claimId": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/controlId" },
        "evidenceDigest": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/sha256" }
      }
    }
  }
}
