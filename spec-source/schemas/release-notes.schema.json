{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifecycle:schema:release-notes:v1",
  "title": "Lifecycle Release Notes v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "releaseNotesId",
    "specificationId",
    "specificationVersion",
    "specificationRevision",
    "publicationDigest",
    "previousPublication",
    "summary",
    "changes",
    "hardCut",
    "knownLimitations",
    "operatorActions",
    "digest"
  ],
  "properties": {
    "schema": { "const": "lifecycle.release-notes.v1" },
    "releaseNotesId": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/opaqueId" },
    "specificationId": { "const": "lifecycle" },
    "specificationVersion": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/opaqueId" },
    "specificationRevision": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/opaqueId" },
    "publicationDigest": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/sha256" },
    "previousPublication": {
      "oneOf": [
        { "$ref": "#/$defs/publicationCoordinate" },
        { "type": "null" }
      ]
    },
    "summary": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/plainText" },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/change" }
    },
    "hardCut": {
      "oneOf": [
        { "$ref": "#/$defs/hardCut" },
        { "type": "null" }
      ]
    },
    "knownLimitations": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/plainText" }
    },
    "operatorActions": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/plainText" }
    },
    "digest": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/sha256" }
  },
  "$defs": {
    "idSet": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/opaqueId" }
    },
    "pathSet": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/normalizedPath" }
    },
    "publicationCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specificationVersion", "specificationRevision", "publicationDigest"],
      "properties": {
        "specificationVersion": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/opaqueId" },
        "specificationRevision": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/opaqueId" },
        "publicationDigest": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/sha256" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "summary",
        "owners",
        "schemas",
        "profiles",
        "compatibilityEffect",
        "securityEffect"
      ],
      "properties": {
        "id": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/opaqueId" },
        "classification": {
          "type": "string",
          "enum": ["initial", "editorial", "additive", "breaking", "security-correction"]
        },
        "summary": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/plainText" },
        "owners": { "$ref": "#/$defs/pathSet" },
        "schemas": { "$ref": "#/$defs/idSet" },
        "profiles": { "$ref": "#/$defs/idSet" },
        "compatibilityEffect": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/plainText" },
        "securityEffect": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/plainText" }
      }
    },
    "hardCut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "treatment",
        "lastAcceptedPredecessorCoordinate",
        "firstAcceptedSuccessorCoordinate",
        "activeAttemptTreatment",
        "historicalRecordTreatment",
        "unsupportedStateTreatment",
        "fixtureIds"
      ],
      "properties": {
        "treatment": { "type": "string", "enum": ["migration-bearing", "fresh-project-only"] },
        "lastAcceptedPredecessorCoordinate": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/singleLine" },
        "firstAcceptedSuccessorCoordinate": {
          "oneOf": [
            { "$ref": "urn:lifecycle:schema:common:v2#/$defs/singleLine" },
            { "type": "null" }
          ]
        },
        "activeAttemptTreatment": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/plainText" },
        "historicalRecordTreatment": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/plainText" },
        "unsupportedStateTreatment": { "$ref": "urn:lifecycle:schema:common:v2#/$defs/plainText" },
        "fixtureIds": { "$ref": "#/$defs/idSet" }
      }
    }
  }
}
